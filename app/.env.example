# ==============================================================================
# Option 4: Web ASG EC2 + AWS Managed Amazon RDS PostgreSQL 16
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# In AWS production, these variables are injected dynamically via AWS Secrets Manager
# into /etc/react-webapp.env (mode 0600) and passed to Docker via --env-file.
# ==============================================================================

# NextAuth Configuration
# AUTH_SECRET: 32+ character high-entropy encryption secret (generated in AWS Secrets Manager: ${EnvironmentName}-web-auth-secret)
AUTH_SECRET=your-32-character-random-hex-auth-secret

# AUTH_URL: Canonical base URL for NextAuth callbacks and session cookie domain
AUTH_URL=https://opt4.example.com

# Database Connection Strings (PostgreSQL 16 Multi-AZ RDS)
# Format: postgres://<user>:<password>@<rds-endpoint>:5432/<dbname>?sslmode=require
POSTGRES_URL=postgres://appadmin:ReplaceWithSecurePassword@dev-postgres-rds.c12345678901.ap-southeast-1.rds.amazonaws.com:5432/appdb?sslmode=require
DATABASE_URL=postgres://appadmin:ReplaceWithSecurePassword@dev-postgres-rds.c12345678901.ap-southeast-1.rds.amazonaws.com:5432/appdb?sslmode=require

# Individual Database Parameters (Optional convenience variables)
DB_HOST=dev-postgres-rds.c12345678901.ap-southeast-1.rds.amazonaws.com
DB_PORT=5432
DB_USER=appadmin
DB_PASSWORD=ReplaceWithSecurePassword
DB_NAME=appdb

# Optional: Path to custom AWS RDS Combined CA Bundle for explicit TLS CA verification
# If omitted, system root trust store (including Amazon Root CA 1-4) is utilized with rejectUnauthorized: true
# RDS_CA_PATH=/etc/pki/tls/certs/rds-combined-ca-bundle.pem

# Optional: Initial admin password for bootstrap schema seeding (if unset, admin seeding is skipped)
# INITIAL_ADMIN_PASSWORD=

# Application Runtime Environment
APP_ENV=dev
PORT=80
NODE_ENV=production
